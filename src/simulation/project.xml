<library>
	<repositories>
		<!-- path to modm repository -->
		<repository>
			<path>../../ext/modm/repo.lb</path>
		</repository>
		<repository>
			<path>../../ext/outpost-core/outpost.lb</path>
		</repository>
		<repository>
			<path>../../ext/outpost-platform-modm/outpost.lb</path>
		</repository>
	</repositories>

	<modules>
		<module>modm:debug</module>
		<module>modm:platform:core</module>
		<module>modm:build:scons</module>
		<module>outpost:base</module>
		<module>outpost:rtos</module>
		<module>outpost:hal</module>
		<module>outpost:swb</module>
	</modules>
	<options>
		<option name="modm:build:scons:include_sconstruct">False</option>
		<option name="outpost:target">posix</option>
		<option name="modm:target">hosted-linux</option>
		<option name="modm:build:build.path">../../build/sim</option>
	</options>
</library>
