import os
from os.path import join, abspath

envGlobal = SConscript('../SConscript.common', must_exist=1)

envGlobal["CCFLAGS"].remove("-Werror=format")

envGlobal.GenerateAllRegisteredLibraries(explain = True)

libdeps = ["sandbox_common", 
           "sandbox_hal",
           "modm"]

envGlobal.InsertDependenciesIntoEnv(libdeps, explain=True)

files = envGlobal.Glob("*.cpp")

if envGlobal['target'] == "host":
    files += envGlobal.Glob("simulation/*.cpp")
    files += envGlobal.Glob("simulation/drv/*.cpp")
    envGlobal.Append(CPPPATH=abspath("simulation"))
elif envGlobal['target'] ==  "bb":
    files += envGlobal.Glob("breadboard/*.cpp")
    files += envGlobal.Glob("breadboard/drv/*.cpp")
    envGlobal.Append(CPPPATH=abspath("breadboard"))

unique_libs = []
envGlobal["LIBS"].reverse()
for lib in envGlobal["LIBS"]:
    if lib not in unique_libs:
        unique_libs.append(lib)
unique_libs.reverse()
envGlobal["LIBS"] = unique_libs

p = envGlobal.BuildTarget(files)
s = envGlobal.Strip("{}/src/{}-stripped.elf".format(envGlobal["BUILDPATH"], envGlobal["program_name"]), p)

envGlobal.Install("../bin/fsw", [p, s])

envGlobal.Alias("install", ["../bin/fsw"])

Default(["build", "install"])


