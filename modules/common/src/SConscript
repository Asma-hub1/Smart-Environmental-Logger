import os

Import('envGlobal')
modulename = "sandbox_" + os.path.basename(os.path.abspath('../'))

includepaths = os.path.abspath('.')

files = envGlobal.RecursiveGlob(".cpp")
impl_files = []
libdeps = []

if 'BUILDTYPE' in envGlobal.keys():
    libdeps.append('outpost_rtos')
else:
    libdeps.append('outpost')

envGlobal.RegisterLibrary(modulename, files, impl_files,
                          includepaths = includepaths, dependencies = libdeps)
